<!DOCTYPE html>
<html>
<head>
    <title>DevOps Todo</title>
    <style>
        body { display:flex; font-family:Arial; margin:0; }
        .sidebar { width:200px; background:#111; color:white; padding:20px; height:100vh; }
        .main { flex:1; padding:20px; background:#f4f6fb; }
        .header { background:#667eea; color:white; padding:15px; border-radius:10px; }
        .task { background:white; margin:10px 0; padding:10px; border-radius:8px; }
    </style>
</head>

<body>

<div class="sidebar">
    <h2>DevOps</h2>
</div>

<div class="main">

    <div class="header">
        <h2>Dashboard</h2>
    </div>

    <form action="/todo/add" method="POST">
        <input name="newtodo" placeholder="Add task">
        <button>Add</button>
    </form>

    <% todolist.forEach(function(todo){ %>
        <div class="task"><%= todo %></div>
    <% }) %>

</div>

</body>
</html>
